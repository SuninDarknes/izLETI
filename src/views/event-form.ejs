<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Novi događaj - izLETI</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <style>
      .bg-light-purple {
        background-color: #8f81ca;
      }
      .bg-light-pozadina {
        background-color: #d0e8e3;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include("./partials/header.ejs") %>

    <main class="container flex-grow-1 py-5">
      <a href="/events" class="btn btn-link link-dark text-decoration-none px-0 mb-3">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
        Natrag na događaje
      </a>

      <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
          <div class="mb-4">
            <span class="badge rounded-pill bg-light-pozadina text-dark mb-2">
              <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>Organizator
            </span>
            <h1 class="display-6 mb-1">Dodaj novi događaj</h1>
            <p class="text-body-secondary mb-0">
              Odaberite izlet i unesite termin te broj dostupnih mjesta.
            </p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <div class="card shadow-sm">
            <div class="card-body p-4 p-md-5">
              <form action="/events/add" method="post">
                <div class="mb-3">
                  <label for="tripId" class="form-label fw-semibold">ID izleta</label>
                  <input
                    type="number"
                    class="form-control"
                    id="tripId"
                    name="tripId"
                    min="1"
                    step="1"
                    value="<%= values.tripId %>"
                    placeholder="Unesite ID postojećeg izleta"
                    required
                  />
                  <div class="form-text">Događaj će biti kreiran za postojeći izlet s ovim ID-om.</div>
                </div>

                <div class="mb-3">
                  <label for="startDateTime" class="form-label fw-semibold">Datum i vrijeme</label>
                  <input
                    type="datetime-local"
                    class="form-control"
                    id="startDateTime"
                    name="startDateTime"
                    value="<%= values.startDateTime %>"
                    required
                  />
                </div>

                <div class="mb-4">
                  <label for="capacity" class="form-label fw-semibold">Kapacitet (broj mjesta)</label>
                  <input
                    type="number"
                    class="form-control"
                    id="capacity"
                    name="capacity"
                    min="1"
                    step="1"
                    value="<%= values.capacity %>"
                    placeholder="npr. 12"
                    required
                  />
                </div>

                <div class="d-flex align-items-center gap-2 text-body-secondary small mb-4">
                  <i class="bi bi-info-circle" aria-hidden="true"></i>
                  Novi događaji dobivaju status „Scheduled”.
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                  <a href="/events" class="btn btn-outline-secondary">Odustani</a>
                  <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    Kreiraj događaj
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
