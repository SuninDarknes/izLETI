<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aktivnosti - izLETI</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <style>
      .bg-light-purple {
        background-color: #8f81ca;
      }
      .bg-light-pozadina {
        background-color: #d0e8e3;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include("./partials/header.ejs") %>

    <main class="container-fluid flex-grow-1 bg-light-pozadina py-4">
      <form action="/activities" method="get">
      <div class="row g-4">
        <aside class="col-lg-3">
          <button
            class="btn btn-outline-dark d-lg-none w-100 mb-3"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#activityFilters"
            aria-controls="activityFilters"
            aria-expanded="false"
          >
            <i class="bi bi-funnel me-1" aria-hidden="true"></i>Filter
          </button>

          <div class="collapse d-lg-block" id="activityFilters">
            <div class="border rounded p-3 bg-white">
              <h2 class="h5 mb-3">Filter aktivnosti</h2>

              <div class="mb-3">
                <label for="filterLocation" class="form-label">Lokacija</label>
                <input
                  type="search"
                  class="form-control"
                  id="filterLocation"
                  name="location"
                  placeholder="Unesite lokaciju"
                  value="<%= query.location %>"
                />
              </div>

              <div class="mb-3">
                <label for="filterCategory" class="form-label">Kategorija</label>
                <select id="filterCategory" name="categoryId" class="form-select">
                  <option value="">Sve kategorije</option>
                  <% categories.forEach(category => { %>
                    <option
                      value="<%= category.id %>"
                      <%= query.categoryId === category.id ? "selected" : "" %>
                    ><%= category.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="mb-3">
                <label for="filterDuration" class="form-label">Trajanje</label>
                <select id="filterDuration" name="duration" class="form-select">
                  <option value="">Sva trajanja</option>
                  <option value="short" <%= query.duration === "short" ? "selected" : "" %>>Do 1 sata</option>
                  <option value="medium" <%= query.duration === "medium" ? "selected" : "" %>>1–2 sata</option>
                  <option value="long" <%= query.duration === "long" ? "selected" : "" %>>Više od 2 sata</option>
                </select>
              </div>

              <div class="d-grid gap-2">
                <button type="submit" class="btn btn-dark">
                  <i class="bi bi-funnel me-1" aria-hidden="true"></i>Primijeni filtere
                </button>
                <a href="/activities" class="btn btn-outline-secondary">Očisti filtere</a>
              </div>
            </div>
          </div>
        </aside>

        <section class="col-lg-9">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
              <h1 class="display-6 mb-1">Aktivnosti</h1>
              <p class="text-body-secondary mb-0">Otkrijte aktivnosti dostupne na našim izletima.</p>
            </div>
            <% if (isOrganizer) { %>
              <a href="/activities/add" class="btn btn-dark flex-shrink-0">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                Nova aktivnost
              </a>
            <% } %>
          </div>

          <div class="mx-auto mb-4" style="max-width: 40rem;" role="search">
            <label for="activitySearch" class="form-label d-block text-center">Pretraži aktivnosti</label>
            <div class="input-group">
              <input
                type="search"
                id="activitySearch"
                name="q"
                class="form-control"
                placeholder="Unesite naziv aktivnosti"
                aria-label="Pretraži aktivnosti"
                value="<%= query.q %>"
              />
              <button class="btn btn-outline-secondary" type="submit" aria-label="Traži">
                <i class="bi bi-search" aria-hidden="true"></i>
              </button>
            </div>
          </div>

          <% if (activities.length === 0) { %>
            <div class="alert alert-info bg-white mb-0" role="status">
              Trenutno nema dostupnih aktivnosti.
            </div>
          <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
              <% activities.forEach(activity => { %>
                <div class="col">
                  <article class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h2 class="h5 card-title mb-0"><%= activity.name %></h2>
                        <% if (activity.categoryName) { %>
                          <span class="badge rounded-pill bg-light-pozadina text-dark">
                            <%= activity.categoryName %>
                          </span>
                        <% } %>
                      </div>

                      <p class="card-text flex-grow-1"><%= activity.description %></p>

                      <ul class="list-unstyled small text-body-secondary mb-3">
                        <li class="mb-1">
                          <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
                          <%= activity.locationName || "Lokacija nije navedena" %>
                        </li>
                        <li>
                          <i class="bi bi-clock me-1" aria-hidden="true"></i>
                          <% if (activity.durationMinutes === null) { %>
                            Trajanje nije navedeno
                          <% } else { %>
                            <%= activity.durationMinutes %> min
                          <% } %>
                        </li>
                      </ul>

                      <a href="/activities/<%= activity.id %>" class="btn btn-outline-dark mt-auto">
                        Pogledaj aktivnost
                        <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                      </a>
                    </div>
                  </article>
                </div>
              <% }); %>
            </div>
          <% } %>
        </section>
      </div>
      </form>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
