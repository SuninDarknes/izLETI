<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= isEditing ? "Uredi aktivnost" : "Nova aktivnost" %> - izLETI</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <style>
      .bg-light-purple {
        background-color: #8f81ca;
      }
      .bg-light-pozadina {
        background-color: #d0e8e3;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include("./partials/header.ejs") %>

    <main class="container flex-grow-1 py-5">
      <a href="/activities" class="btn btn-link link-dark text-decoration-none px-0 mb-3">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
        Natrag na aktivnosti
      </a>

      <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">
          <div class="mb-4">
            <h1 class="display-6 mb-1"><%= isEditing ? "Uredi aktivnost" : "Dodaj novu aktivnost" %></h1>
            <p class="text-body-secondary mb-0">Unesite osnovne podatke o aktivnosti.</p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger" role="alert"><%= error %></div>
          <% } %>

          <div class="card shadow-sm">
            <div class="card-body p-4">
              <form
                action="<%= isEditing ? `/activities/${activity.id}/edit` : '/activities/add' %>"
                method="post"
              >
                <div class="mb-3">
                  <label for="name" class="form-label">Naziv aktivnosti</label>
                  <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="name"
                    value="<%= activity?.name ?? '' %>"
                    placeholder="npr. Šetnja starom jezgrom"
                    required
                  />
                </div>

                <div class="mb-3">
                  <label for="description" class="form-label">Opis</label>
                  <textarea
                    class="form-control"
                    id="description"
                    name="description"
                    rows="4"
                    placeholder="Opišite što će sudionici raditi."
                  ><%= activity?.description ?? '' %></textarea>
                </div>

                <div class="mb-3">
                  <label for="categoryId" class="form-label">Kategorija</label>
                  <select class="form-select" id="categoryId" name="categoryId" required>
                    <option value="">Odaberite kategoriju</option>
                    <% categories.forEach(category => { %>
                      <option
                        value="<%= category.id %>"
                        <%= activity && Number(activity.categoryId) === category.id ? "selected" : "" %>
                      ><%= category.name %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="mb-3">
                  <label for="locationName" class="form-label">Lokacija</label>
                  <input
                    type="text"
                    class="form-control"
                    id="locationName"
                    name="locationName"
                    value="<%= activity?.locationName ?? '' %>"
                    placeholder="npr. Gornji grad, Zagreb"
                  />
                </div>

                <fieldset class="border rounded p-3 mb-3">
                  <legend class="float-none w-auto px-2 fs-6 mb-0">Koordinate lokacije</legend>
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label for="latitude" class="form-label">Geografska širina</label>
                      <input
                        type="number"
                        class="form-control"
                        id="latitude"
                        name="latitude"
                        min="-90"
                        max="90"
                        step="any"
                        value="<%= activity?.latitude ?? '' %>"
                        placeholder="45.8150"
                        required
                      />
                    </div>
                    <div class="col-12 col-md-6">
                      <label for="longitude" class="form-label">Geografska dužina</label>
                      <input
                        type="number"
                        class="form-control"
                        id="longitude"
                        name="longitude"
                        min="-180"
                        max="180"
                        step="any"
                        value="<%= activity?.longitude ?? '' %>"
                        placeholder="15.9819"
                        required
                      />
                    </div>
                  </div>
                </fieldset>

                <div class="mb-4">
                  <label for="durationMinutes" class="form-label">Trajanje (minute)</label>
                  <input
                    type="number"
                    class="form-control"
                    id="durationMinutes"
                    name="durationMinutes"
                    min="1"
                    step="1"
                    value="<%= activity?.durationMinutes ?? '' %>"
                    placeholder="60"
                  />
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                  <a
                    href="<%= isEditing ? `/activities/${activity.id}` : '/activities' %>"
                    class="btn btn-outline-secondary"
                  >Odustani</a>
                  <button type="submit" class="btn btn-dark">
                    <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                    <%= isEditing ? "Spremi promjene" : "Dodaj aktivnost" %>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
