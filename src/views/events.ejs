<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>izLETI – Događaji</title>

  <!-- 1. Bootstrap CSS + Icons (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  
  <style>
    :root {
        --bs-primary: #8f81ca;    
      }
    .bg-light-purple {
      background-color: #8f81ca;
    }

    .bg-light-pozadina {
      background-color: #d0e8e3;
    }


    .event-img { background: #dedede; min-height: 160px; }
    .event-img i { font-size: 4rem; color: #b9b9b9; }
    .event-img img { object-fit: cover; }

    /* Dual-handle price slider */
    .range-dual { position: relative; height: 1.5rem; }
    .range-track, .range-fill {
      position: absolute; top: 50%; height: .5rem;
      transform: translateY(-50%); border-radius: 1rem;
    }
    .range-track { left: 0; right: 0; background: var(--bs-secondary-bg); }
    .range-fill  { background: var(--bs-primary); }

    .range-dual input[type=range] {
      position: absolute; left: 0; top: 0; width: 100%; height: 100%;
      margin: 0; background: none;
      -webkit-appearance: none; appearance: none;
      pointer-events: none;            /* let clicks pass through the bar... */
    }
    .range-dual input[type=range]::-webkit-slider-runnable-track { background: transparent; height: .5rem; }
    .range-dual input[type=range]::-moz-range-track { background: transparent; height: .5rem; }
    .range-dual input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none; pointer-events: auto;   /* ...but keep the handles draggable */
      width: 1.25rem; height: 1.25rem; margin-top: -.375rem;
      border: 0; border-radius: 50%; background: var(--bs-primary); cursor: pointer;
    }
    .range-dual input[type=range]::-moz-range-thumb {
      pointer-events: auto;
      width: 1.25rem; height: 1.25rem;
      border: 0; border-radius: 50%; background: var(--bs-primary); cursor: pointer;
    }
    .range-dual input[type=range]:focus-visible { outline: none; }
    .range-dual input[type=range]:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 .25rem rgba(var(--bs-primary-rgb), .35); }
    .range-dual input[type=range]:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 .25rem rgba(var(--bs-primary-rgb), .35); }
  </style>
</head>
<body class="d-flex flex-column min-vh-100">

  <%- include("./partials/header.ejs") %>

  <main class="container-fluid flex-grow-1 bg-light-pozadina py-3">
    <div class="row g-4">

      <!-- ========== FILTER SIDEBAR ========== -->
      <aside class="col-lg-3">
        <!-- button only visible on phones/tablets -->
        <button class="btn btn-outline-dark d-lg-none w-100 mb-3" type="button"
                data-bs-toggle="collapse" data-bs-target="#filters" aria-controls="filters">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>

        <!-- always visible from "lg" up, collapsible below -->
        <div class="collapse d-lg-block" id="filters">
          <form class="border rounded p-3 bg-white">
            <h2 class="h5 mb-3">Filter</h2>

            <div class="mb-3">
              <label for="mjesto" class="form-label">Mjesto</label>
              <select id="mjesto" class="form-select">
                <option selected></option>
                <option>Zagreb</option>
                <option>Split</option>
                <option>Rijeka</option>
              </select>
            </div>

            <div class="mb-3">
              <label for="datumOd" class="form-label">Datum od</label>
              <input type="date" id="datumOd" class="form-control">
            </div>

            <div class="mb-3">
              <label for="datumDo" class="form-label">Datum do</label>
              <input type="date" id="datumDo" class="form-control">
            </div>

            <div class="mb-3">
              <label for="brojLjudi" class="form-label">Broj ljudi</label>
              <select id="brojLjudi" class="form-select">
                <option selected></option>
                <option>1</option><option>2</option><option>3</option>
                <option>4</option><option>5+</option>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label">Cijena</label>

              <!-- two range inputs stacked on one track -->
              <div class="range-dual">
                <div class="range-track"></div>
                <div class="range-fill" id="cijenaFill"></div>
                <input type="range" id="cijenaMin" min="0" max="10000" step="50" value="0" aria-label="Minimalna cijena">
                <input type="range" id="cijenaMax" min="0" max="10000" step="50" value="10000" aria-label="Maksimalna cijena">
              </div>

              <div class="d-flex justify-content-between small mt-1">
                <span><span id="cijenaMinVal">0</span>€</span>
                <span><span id="cijenaMaxVal">10000</span>€</span>
              </div>
            </div>

            <div class="mb-2">
              <label for="tagovi" class="form-label">Tagovi</label>
              <input type="text" id="tagovi" class="form-control">
            </div>

            <!-- selected tags -->
            <div class="d-flex flex-wrap gap-2">
              <button type="button" class="btn btn-outline-dark btn-sm">tag 1 <i class="bi bi-x-lg ms-1"></i></button>
              <button type="button" class="btn btn-outline-dark btn-sm">tag 2 <i class="bi bi-x-lg ms-1"></i></button>
              <button type="button" class="btn btn-outline-dark btn-sm">tag 3 <i class="bi bi-x-lg ms-1"></i></button>
            </div>
          </form>
        </div>
      </aside>

      <!-- ========== RESULTS ========== -->
      <section class="col-lg-9">

        <!-- search -->
        <form class="mx-auto mb-4" style="max-width: 40rem;" role="search">
          <label for="trazi" class="form-label d-block text-center">Pretraži izlete</label>
          <div class="input-group">
            <input type="search" id="trazi" class="form-control">
            <button class="btn btn-outline-secondary" type="submit" aria-label="Traži">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </form>

        <!-- EVENT CARD (copy this block for each trip) -->
        <article class="card mb-3">
          <div class="row g-0">

            <!-- image -->
            <div class="col-md-3 event-img d-flex align-items-center justify-content-center">
              <i class="bi bi-image"></i>
              <!-- real image: <img src="images/izlet1.jpg" alt="Izlet v Prisavlje" class="w-100 h-100"> -->
            </div>

            <!-- details -->
            <div class="col-md-9">
              <div class="card-body h-100 d-flex flex-column flex-md-row justify-content-between gap-3">

                <!-- left: title, place, tags, dates -->
                <div>
                  <h3 class="h5 card-title mb-0">
                    Izlet v Prisavlje
                    <span class="ms-2 fs-6" aria-label="Ocjena 3,5 od 5">
                      <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i><i class="bi bi-star"></i>
                    </span>
                  </h3>
                  <p class="text-body-secondary mb-2">Zagreb</p>

                  <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-outline-dark btn-sm">tag 1</button>
                    <button type="button" class="btn btn-outline-dark btn-sm">tag 2</button>
                    <button type="button" class="btn btn-outline-dark btn-sm">tag 3</button>
                  </div>

                  <div class="d-flex flex-wrap align-items-center gap-2">
                    <span>Datumi:</span>
                    <span class="badge text-bg-light border fw-normal">12.3.</span>
                    <span class="badge text-bg-light border fw-normal">19.3.</span>
                  </div>
                </div>

                <!-- right: price at top, button at bottom -->
                <div class="d-flex flex-md-column justify-content-between align-items-center align-items-md-end">
                  <span class="fs-5">100€</span>
                  <a href="/events/eventsid" class="btn btn-dark px-4">Pregledaj <i class="bi bi-chevron-right"></i></a>
                </div>

              </div>
            </div>
          </div>
        </article>

        <!-- second card (empty in the wireframe: fill in the same way) -->
        <article class="card mb-3">
          <div class="row g-0">
            <div class="col-md-3 event-img d-flex align-items-center justify-content-center">
              <i class="bi bi-image"></i>
            </div>
            <div class="col-md-9">
              <div class="card-body">
                <h3 class="h5 card-title">Naziv izleta</h3>
              </div>
            </div>
          </div>
        </article>

      </section>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    // Dual price slider: keeps min <= max, updates labels and the coloured bar
    const minInput = document.getElementById('cijenaMin');
    const maxInput = document.getElementById('cijenaMax');
    const fill     = document.getElementById('cijenaFill');
    const minLabel = document.getElementById('cijenaMinVal');
    const maxLabel = document.getElementById('cijenaMaxVal');
    const LIMIT = Number(maxInput.max);

    function updatePrice(e) {
      let lo = Number(minInput.value);
      let hi = Number(maxInput.value);

      if (lo > hi) {                       // handles can't cross
        if (e && e.target === minInput) { lo = hi; minInput.value = lo; }
        else                            { hi = lo; maxInput.value = hi; }
      }

      fill.style.left  = (lo / LIMIT * 100) + '%';
      fill.style.right = (100 - hi / LIMIT * 100) + '%';
      minLabel.textContent = lo;
      maxLabel.textContent = hi;

      // if both handles are at the right end, keep the min handle on top so it can still be grabbed
      minInput.style.zIndex = lo > LIMIT / 2 ? 3 : 1;
      maxInput.style.zIndex = 2;
    }

    minInput.addEventListener('input', updatePrice);
    maxInput.addEventListener('input', updatePrice);
    updatePrice();
  </script>
</body>
</html>