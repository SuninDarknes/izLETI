
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in | My App</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
   <link rel="stylesheet" href="/css/style.css">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script src="/scripts/script.js" defer></script>
</head>
<body class="d-flex align-items-center justify-content-center p-3">

    <main class="card login-card shadow-lg p-4 p-md-5 text-center">

        <div class="app-logo mb-4">A</div>

        <h1 class="h3 fw-bold mb-2">Welcome</h1>
        <p class="text-secondary mb-4">
            Sign in with your Google account to continue.
        </p>

        <div id="google-signin" class="d-flex justify-content-center"></div>

        <div id="message" class="small mt-3" role="status" aria-live="polite"></div>

        <p class="text-secondary small mt-4 mb-0">
            By continuing, you agree to our Terms and Privacy Policy.
        </p>

    </main>

</body>
</html>
