<!DOCTYPE html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>izLETI - Početna</title>

    <!-- 1. Bootstrap CSS + Icons (CDN) -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />

    <style>
      /* Small custom touches; everything else is Bootstrap classes */
      .side-image img {
        object-fit: cover;
      }
      .side-image i {
        font-size: 5rem;
        color: #b9b9b9;
      }
      .bg-light-purple {
        background-color: #8f81ca;
      }
      :root {
        --bs-body-bg: #ffffff; /* Changes the default background color */
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">
    <%- include("./partials/header.ejs") %>

    <!-- 3. MAIN: 3 columns (image | content | image) -->
    <main class="container-fluid flex-grow-1 d-flex flex-column">
      <div class="row flex-grow-1">
        <!-- left image: hidden below "md" so phones show only the center -->
        <div
          class="col-md-3 side-image d-none d-md-block position-relative p-0"
        >
          <img
            src="images/WilderBuildingSummerSolstice.jpg"
            alt="Slika"
            class="position-absolute top-0 start-0 w-100 h-100"
          />
        </div>

        <!-- center content -->
        <div class="col-12 col-md-6 py-5 text-center">
          <h1 class="display-4 mb-4">izLETI</h1>
          <p class="lead mx-auto" style="max-width: 32rem">
            Mi smo najbolja agencija za lokalne turističke izlete!! <br />
            Pravo domače!
          </p>

          <!-- search box with icon button -->
          <form class="mt-5 mx-auto" style="max-width: 32rem" role="search">
            <div class="input-group">
              <input
                type="search"
                class="form-control"
                placeholder="Pretraži..."
                aria-label="Pretraga"
              />
              <button
                class="btn btn-outline-secondary"
                type="submit"
                aria-label="Traži"
              >
                <i class="bi bi-search"></i>
              </button>
            </div>
          </form>
        </div>

        <!-- right image -->
        <div
          class="col-md-3 side-image d-none d-md-block position-relative p-0"
        >
          <img
            src="images/slika1probna.jpg"
            alt="Slika"
            class="position-absolute top-0 start-0 w-100 h-100"
          />
        </div>
      </div>
    </main>

    <!--FOOTER: kontakt, adresa-->
    <footer class="bg-light-purple py-3">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12 col-sm-auto me-sm-4">
            <h2 class="h6">Kontakt</h2>
            <p class="mb-0 small">info@izleti.hr<br />+385 12 223 333</p>
          </div>
          <div class="col-12 col-sm-auto">
            <h2 class="h6">Adresa</h2>
            <p class="mb-0 small">Unska ul. 3, 10000 Zagreb</p>
          </div>
        </div>
      </div>
    </footer>

    <!--Bootstrap JS (needed for the hamburger menu)-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
